{
  "name": "hackaton",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hackaton/api --filter @hackaton/web --parallel run dev",
    "dev:api": "pnpm --filter @hackaton/api dev",
    "dev:web": "pnpm --filter @hackaton/web dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @hackaton/api test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.6.0",
      "onFail": "ignore"
    }
  }
}
